# 값은 비워 두고 커밋합니다. 실제 값은 backend/.env 에 넣습니다 (커밋 금지).
DATABASE_URL=
# Supabase Transaction pooler의 연결 문자열도 사용 가능:
# postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?sslmode=require
JWT_SECRET=
JWT_ISSUER=mama-api
JWT_AUDIENCE=mama-api
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
# Docker Compose 개발 DB 전용. DATABASE_URL의 비밀번호와 맞춥니다.
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
MYSQL_PORT=3307
# 테스트 DB 전용 URL. 개발 DB를 넣지 않습니다.
TEST_DATABASE_URL=
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_TIMEOUT=60
