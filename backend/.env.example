# 값은 비워 두고 커밋합니다. 실제 값은 backend/.env 에 넣습니다 (커밋 금지).
# PostgreSQL 예: postgresql://user:password@host:6543/postgres?sslmode=require
DATABASE_URL=
# 테스트 DB 전용 URL. 개발 DB를 넣지 않습니다.
TEST_DATABASE_URL=
# LLM은 나중에 설정해도 서버·캠페인 API는 실행됩니다.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_TIMEOUT=60
# Supabase Auth 로그인 확인. 프론트 NEXT_PUBLIC_SUPABASE_URL과 같은 프로젝트 주소 (https://<프로젝트ref>.supabase.co)
# 토큰 서명은 이 주소의 공개키(JWKS)로 검증하므로 비밀값이 필요 없습니다. service_role 키를 넣지 않습니다.
SUPABASE_URL=
# 마이그레이션 0006 전용. 로그인 도입 전에 만든 캠페인을 넘겨받을 셀러의 Google 이메일 (소유자 없는 캠페인이 있을 때만 필요)
LEGACY_OWNER_EMAIL=
