# 값은 비워 두고 커밋합니다. 실제 값은 backend/.env 에 넣습니다 (커밋 금지).
# PostgreSQL 예: postgresql://user:password@host:6543/postgres?sslmode=require
DATABASE_URL=
# 테스트 DB 전용 URL. 개발 DB를 넣지 않습니다.
TEST_DATABASE_URL=
# LLM은 나중에 설정해도 서버·캠페인 API는 실행됩니다.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_TIMEOUT=60
# Google 로그인 (Google Cloud Console > API 및 서비스 > 사용자 인증 정보 > OAuth 클라이언트 ID, 유형: 웹 애플리케이션)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google 콘솔의 "승인된 리디렉션 URI"와 글자까지 같아야 함. 프론트 주소 + /api/v1/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback
# 로그인 중간 상태 서명용 임의 문자열 32자 이상. 생성: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# 배포(https)에서는 true
COOKIE_SECURE=false
# 마이그레이션 0006 전용. 로그인 도입 전에 만든 캠페인을 넘겨받을 셀러의 Google 이메일 (소유자 없는 캠페인이 있을 때만 필요)
LEGACY_OWNER_EMAIL=
