# 값은 비워 두고 커밋합니다. 실제 값은 backend/.env 에 넣습니다 (커밋 금지).
# PostgreSQL 예: postgresql://user:password@host:6543/postgres?sslmode=require
DATABASE_URL=
# 테스트 DB 전용 URL. 개발 DB를 넣지 않습니다.
TEST_DATABASE_URL=
# LLM은 나중에 설정해도 서버·캠페인 API는 실행됩니다.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_TIMEOUT=60
