# 로컬: http://localhost:8000 / 배포: 백엔드 Vercel 주소. NEXT_PUBLIC_ 을 붙이지 않습니다.
BACKEND_URL=

# Supabase Auth(Google 로그인). 대시보드 Project Settings → API에서 복사합니다.
# 브라우저가 Google 로그인을 시작해야 해서 NEXT_PUBLIC_ 으로 둡니다. publishable(anon) 키만 넣습니다.
# service_role(secret) 키·DB 비밀번호는 절대 넣지 않습니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
